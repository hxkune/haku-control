// Icons and version info: shown as "haku control" in Explorer and Task Manager.
#include <windows.h>
#include "version.h"

1 ICON "app.ico"          // white mark on black: exe and window
2 ICON "tray-dark.ico"    // tray, dark taskbar
3 ICON "tray-light.ico"   // tray, light taskbar

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HAKU_VER_NUM
 PRODUCTVERSION HAKU_VER_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "haku"
      VALUE "FileDescription", "haku control"
      VALUE "ProductName", "haku control"
      VALUE "LegalCopyright", "(C) 2026 haku. GPL-3.0"
      VALUE "FileVersion", HAKU_VER_STR
      VALUE "ProductVersion", HAKU_VER_STR
      VALUE "InternalName", "haku-control"
      VALUE "OriginalFilename", "haku-control.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
